@model Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.Models.Course

@{
    ViewData["Title"] = "Chi tiết khóa học";
}

<div class="container mt-4">

    <h2 class="mb-4">@Model.Title</h2>

    <div class="card shadow-sm">

        <div class="card-body">

            <h5>Thông tin khóa học</h5>

            <hr />

            <p>
                <strong>Tên khóa học:</strong>
                @Model.Title
            </p>

            <p>
                <strong>Mô tả:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Giảng viên:</strong>
                @(Model.Instructor?.FullName ?? "Chưa cập nhật")
            </p>

            <p>
                <strong>Giá khóa học:</strong>

                @if (Model.Price == 0)
                {
                    <span class="text-success fw-bold">
                        Miễn phí
                    </span>
                }
                else
                {
                    <span class="text-danger fw-bold">
                        @Model.Price.ToString("N0") VNĐ
                    </span>
                }
            </p>

            <p>
                <strong>Trạng thái:</strong>
                @if (Model.Status == "Published")
                {
                    <span class="badge bg-success">Công khai</span>
                }
                else if (Model.Status == "Pending")
                {
                    <span class="badge bg-warning text-dark">Chờ duyệt</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge bg-danger">Bị từ chối</span>
                }
                else
                {
                    @Model.Status
                }
            </p>

            @if (Model.Status == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="alert alert-danger">
                    <strong>Lý do từ chối:</strong> @Model.RejectionReason
                    <div class="small mt-1">Sửa lại khóa học để gửi duyệt lại.</div>
                </div>
            }

            <hr />

            @if (User.IsInRole("HocVien"))
            {
                @if (Model.Price == 0)
                {
                    <form asp-controller="Enrollments"
                          asp-action="Enroll"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="courseId"
                               value="@Model.CourseId" />

                        <button type="submit"
                                class="btn btn-success">
                            Đăng ký khóa học
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Transactions"
                       asp-action="Checkout"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-success">
                        Mua khóa học (@Model.Price.ToString("N0") VNĐ)
                    </a>
                }
            }

            @if (User.IsInRole("Admin") ||
                        User.IsInRole("GiangVien"))
            {
                <a asp-controller="Lessons"
                   asp-action="Index"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-primary mt-2">
                    Quản lý bài học
                </a>
            }

            @if (User.IsInRole("Admin") ||
                        User.IsInRole("GiangVien"))
            {
                <a asp-controller="Quizzes"
                   asp-action="Index"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-primary mt-2">
                    Quản lý Quiz
                </a>
            }

            @if (User.IsInRole("Admin") ||
                        User.IsInRole("GiangVien"))
            {
                <a asp-controller="Quizzes"
                   asp-action="Index"
                   asp-route-courseId="@Model.CourseId"
                   class="btn btn-info mt-2">
                    Quản lý bài kiểm tra
                </a>
            }

            <div class="mt-3">
                <a asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Quay lại danh sách khóa học
                </a>
            </div>

        </div>
    </div>

</div>
