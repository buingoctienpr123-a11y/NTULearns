<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.styles.css" asp-append-version="true" />
</head>
<body>
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    NTU Learn
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#ntuNavbar"
                        aria-controls="ntuNavbar"
                        aria-expanded="false"
                        aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="ntuNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Danh sách khóa học -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Courses"
                               asp-action="Index">
                                Khóa học
                            </a>
                        </li>

                        @if (User.IsInRole("Admin") ||
                                                User.IsInRole("GiangVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="UsersManagement"
                                   asp-action="Index">
                                    Quản lý người dùng
                                </a>
                            </li>
                        }

                        <!-- Khóa học của tôi: chỉ học viên nhìn thấy -->
                        @if (User.IsInRole("HocVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Enrollments"
                                   asp-action="MyCourses">
                                    Khóa học của tôi
                                </a>
                            </li>
                        }

                    </ul>



                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-white">
                                Xin chào, @User.Identity.Name
                            </span>

                            <form asp-controller="Auth"
                                  asp-action="Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-light text-primary">
                                    Đăng xuất
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-light"
                               asp-controller="Auth"
                               asp-action="Login">
                                Đăng nhập
                            </a>

                            <a class="btn btn-light text-primary"
                               asp-controller="Auth"
                               asp-action="Register">
                                Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
