@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Phần giới thiệu -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="hero-label">NTU LEARN</span>

                <h1 class="hero-title">
                    Khám phá tri thức.<br />
                    Phát triển tương lai.
                </h1>

                <p class="hero-description">
                    Học trực tuyến cùng NTU Learn.
                    Tìm kiếm khóa học, học theo lộ trình
                    và theo dõi tiến độ học tập của bạn.
                </p>

                <a href="#courses" class="btn btn-light btn-lg">
                    Khám phá khóa học
                </a>
            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="hero-card">
                    <div class="hero-icon">NTU</div>
                    <h3>Học tập mọi lúc</h3>
                    <p>
                        Chủ động thời gian, xây dựng kiến thức
                        và phát triển kỹ năng của bạn.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Danh mục khóa học -->
<section class="container section-spacing">
    <div class="section-heading">
        <div>
            <p class="section-subtitle">KHÁM PHÁ</p>
            <h2>Danh mục khóa học</h2>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-3">
            <a href="#courses" class="category-card">
                <span class="category-icon">01</span>
                <span>Lập trình</span>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="#courses" class="category-card">
                <span class="category-icon">02</span>
                <span>Cơ sở dữ liệu</span>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="#courses" class="category-card">
                <span class="category-icon">03</span>
                <span>Thiết kế web</span>
            </a>
        </div>

        <div class="col-6 col-md-4 col-lg-3">
            <a href="#courses" class="category-card">
                <span class="category-icon">04</span>
                <span>Công nghệ thông tin</span>
            </a>
        </div>
    </div>
</section>

<!-- Danh sách khóa học -->
<section id="courses" class="container section-spacing">
    <div class="section-heading">
        <div>
            <p class="section-subtitle">HỌC TẬP MỖI NGÀY</p>
            <h2>Khóa học nổi bật</h2>
            <p class="text-secondary">
                Khám phá các khóa học dành cho bạn.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Khóa học 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="course-card h-100">
                <div class="course-cover cover-blue">
                    <span>LẬP TRÌNH</span>
                </div>

                <div class="course-body">
                    <span class="course-category">Lập trình</span>
                    <h5>Lập trình C# cơ bản</h5>
                    <p>
                        Làm quen với biến, câu lệnh,
                        phương thức và lập trình hướng đối tượng.
                    </p>

                    <div class="course-footer">
                        <span>Khóa học mẫu</span>
                        <a href="#courses">Tìm hiểu</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khóa học 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="course-card h-100">
                <div class="course-cover cover-green">
                    <span>CƠ SỞ DỮ LIỆU</span>
                </div>

                <div class="course-body">
                    <span class="course-category">Cơ sở dữ liệu</span>
                    <h5>SQL Server căn bản</h5>
                    <p>
                        Tìm hiểu cách tạo bảng, truy vấn,
                        liên kết và quản lý dữ liệu.
                    </p>

                    <div class="course-footer">
                        <span>Khóa học mẫu</span>
                        <a href="#courses">Tìm hiểu</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khóa học 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="course-card h-100">
                <div class="course-cover cover-orange">
                    <span>THIẾT KẾ WEB</span>
                </div>

                <div class="course-body">
                    <span class="course-category">Thiết kế web</span>
                    <h5>HTML và CSS cơ bản</h5>
                    <p>
                        Học cách xây dựng bố cục,
                        định dạng và thiết kế giao diện website.
                    </p>

                    <div class="course-footer">
                        <span>Khóa học mẫu</span>
                        <a href="#courses">Tìm hiểu</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Phần giới thiệu cuối trang -->
<section class="container section-spacing">
    <div class="learning-banner">
        <h2>Bắt đầu hành trình học tập của bạn</h2>
        <p>
            Khám phá kiến thức mới và theo dõi quá trình học tập
            cùng NTU Learn.
        </p>
        <a href="#courses" class="btn btn-primary">
            Xem khóa học
        </a>
    </div>
</section>
