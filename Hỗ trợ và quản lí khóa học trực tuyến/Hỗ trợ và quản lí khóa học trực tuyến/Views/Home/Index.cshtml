@model Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Banner -->
<section class="ntu-hero mb-5">
    <div class="row align-items-center g-4">

        <div class="col-lg-7">

            <span class="badge bg-light text-primary mb-3">
                Nền tảng học tập NTU Learn
            </span>

            <h1 class="display-5 fw-bold mb-3">
                Học tập trực tuyến,
                phát triển kỹ năng mỗi ngày
            </h1>

            <p class="lead mb-4">
                Khám phá các khóa học phù hợp,
                theo dõi tiến độ học tập và
                kiểm tra kiến thức trực tuyến.
            </p>

            <a asp-controller="Courses"
               asp-action="Index"
               class="btn btn-light btn-lg">
                Khám phá khóa học
            </a>

        </div>

        <div class="col-lg-5 text-center">
            <div class="ntu-hero-icon">
                🎓
            </div>
        </div>

    </div>
</section>

<!-- Thống kê -->
<section class="mb-5">

    <div class="row g-3">

        <div class="col-md-4">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h2 class="text-primary">
                        @Model.TotalCourses
                    </h2>
                    <p class="mb-0">Khóa học</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h2 class="text-success">
                        @Model.TotalStudents
                    </h2>
                    <p class="mb-0">Học viên</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm h-100">
                <div class="card-body">
                    <h2 class="text-info">
                        @Model.TotalLessons
                    </h2>
                    <p class="mb-0">Bài học</p>
                </div>
            </div>
        </div>

    </div>

</section>

<!-- Khóa học nổi bật -->
<section class="mb-5">

    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Khóa học nổi bật
            </h2>

            <p class="text-muted mb-0">
                Khám phá những khóa học được quan tâm
            </p>
        </div>

        <a asp-controller="Courses"
           asp-action="Index"
           class="btn btn-outline-primary">
            Xem tất cả
        </a>

    </div>

    <!-- Tìm kiếm -->
    <form asp-controller="Home"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">

            <input type="text"
                   name="keyword"
                   value="@Model.Keyword"
                   class="form-control"
                   placeholder="Tìm kiếm khóa học..." />

            <button type="submit"
                    class="btn btn-primary">
                Tìm kiếm
            </button>

        </div>

    </form>

    @if (!Model.FeaturedCourses.Any())
    {
        <div class="alert alert-info">
            Không tìm thấy khóa học phù hợp.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var course in Model.FeaturedCourses)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card ntu-course-card h-100 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(course.ThumbnailUrl))
                        {
                            <img src="@course.ThumbnailUrl"
                                 class="card-img-top ntu-course-image"
                                 alt="@course.Title"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="ntu-course-placeholder">
                                📚
                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <span class="text-primary small mb-2">
                                @course.CategoryName
                            </span>

                            <h5 class="card-title">
                                @course.Title
                            </h5>

                            <p class="card-text text-muted small
                                              ntu-course-description">
                                @course.Description
                            </p>

                            <p class="small mb-2">
                                Giảng viên:
                                <strong>@course.InstructorName</strong>
                            </p>

                            <p class="small text-muted">
                                @course.EnrollmentCount lượt đăng ký
                            </p>

                            <div class="mt-auto">

                                @if (course.Price == 0)
                                {
                                    <p class="text-success fw-bold">
                                        Miễn phí
                                    </p>
                                }
                                else
                                {
                                    <p class="text-primary fw-bold">
                                        @course.Price.ToString("N0") VNĐ
                                    </p>
                                }

                                <a asp-controller="Courses"
                                   asp-action="Details"
                                   asp-route-id="@course.CourseId"
                                   class="btn btn-primary w-100">
                                    Xem chi tiết
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</section>

<!-- Giới thiệu -->
<section class="ntu-features mb-4">

    <h2 class="text-center fw-bold mb-4">
        Tại sao chọn NTU Learn?
    </h2>

    <div class="row g-4 text-center">

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="fs-1 mb-3">📖</div>
                    <h5>Học tập linh hoạt</h5>
                    <p class="text-muted">
                        Truy cập nội dung khóa học
                        và học theo tiến độ của mình.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="fs-1 mb-3">📊</div>
                    <h5>Theo dõi tiến độ</h5>
                    <p class="text-muted">
                        Xem các bài học đã hoàn thành
                        và tiến độ của từng khóa học.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="fs-1 mb-3">📝</div>
                    <h5>Kiểm tra kiến thức</h5>
                    <p class="text-muted">
                        Làm Quiz trực tuyến,
                        nhận kết quả và xem lịch sử.
                    </p>
                </div>
            </div>
        </div>

    </div>

</section>
