@model List<Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.Models.User>

@{
    ViewData["Title"] = "Duyệt giảng viên";
}

<div class="container mt-4 mb-5">

    <h2 class="mb-2">Phê duyệt</h2>

    <p class="text-muted">
        Duyệt tài khoản giảng viên mới đăng ký
    </p>

    <partial name="_Tabs" />

    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="mb-3">
                Giảng viên chờ duyệt
                <span class="badge bg-primary">
                    @Model.Count
                </span>
            </h5>

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Mã</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Ngày đăng ký</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted">
                                    Không có giảng viên nào đang chờ duyệt.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.UserId</td>

                                    <td>
                                        <strong>
                                            @user.FullName
                                        </strong>
                                    </td>

                                    <td>@user.Email</td>

                                    <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>
                                        <form asp-controller="Approvals"
                                              asp-action="ReviewInstructor"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <input type="hidden" name="approve" value="true" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Duyệt
                                            </button>
                                        </form>

                                        <form asp-controller="Approvals"
                                              asp-action="ReviewInstructor"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Từ chối giảng viên này?');">

                                            <input type="hidden" name="id" value="@user.UserId" />
                                            <input type="hidden" name="approve" value="false" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Từ chối
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
