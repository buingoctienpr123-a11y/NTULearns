@model IEnumerable<Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.Models.Transaction>

@using Hỗ_trợ_và_quản_lí_khóa_học_trực_tuyến.Models

@{
    ViewData["Title"] = "Lịch sử giao dịch";
}

<div class="container mt-4 mb-5">

    <h2 class="mb-4">Lịch sử giao dịch</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Mã giao dịch</th>
                            <th>Khóa học</th>
                            <th>Số tiền</th>
                            <th>Phương thức</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th>Ngày thanh toán</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    Bạn chưa có giao dịch nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><code>@item.TransactionCode</code></td>
                                    <td>@item.Course?.Title</td>
                                    <td>@item.Amount.ToString("N0") VNĐ</td>
                                    <td>@PaymentMethods.DisplayName(item.PaymentMethod)</td>
                                    <td><partial name="_StatusBadge" model="item.Status" /></td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@(item.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <a asp-action="Pay"
                                               asp-route-code="@item.TransactionCode"
                                               class="btn btn-primary btn-sm">
                                                Thanh toán
                                            </a>
                                        }
                                        else if (item.Status == "Success")
                                        {
                                            <a asp-controller="Learning"
                                               asp-action="Index"
                                               asp-route-courseId="@item.CourseId"
                                               class="btn btn-outline-success btn-sm">
                                                Vào học
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
